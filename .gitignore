# Factory-Template .gitignore

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/settings.json
*.iml

# Logs
*.log
logs/

# Temporäre Factory-Dateien
tasks/pipeline-stuck-*.md
*.tmp.txt
*.tmp.sh
*.tmp.py
*.tmp.spec.ts
*.tmp.config.ts
coverage-*-tmp/
.verify-*/

# Generierte Metrik-Reports (Snapshots, jederzeit regenerierbar via /daily-metrics).
# Das append-only tasks/interrupt-log.jsonl ist BEWUSST nicht ignoriert –
# es ist die persistente Quelle der Autonomie-Rate und gehört in die Historie.
tasks/metrics-*.md


# ── dev-factory (Projekt-Anteil) ──
# Wegwerf-/Scratch-Artefakte der Self-Tests und Probeläufe
*.tmp.*
.coverage-tmp*/
coverage/
# Lokale Secrets (start-work.sh spiegelt nur, was start_work.copy_files listet)
.env.local
